# IRecover -- server-side configuration
#
# These are consumed ONLY by Cloudflare Pages Functions under /functions,
# which run on Cloudflare's servers. They are never bundled into client
# code and must NOT be prefixed with VITE_ (Vite would otherwise expose
# them to the browser).
#
# Set the real values in the Cloudflare Pages project's
# Settings -> Environment variables (Production and Preview), or in a local
# .dev.vars file (also gitignored) for `wrangler pages dev`. Never commit
# real credentials.

# Photo Finish (functions/api/photo-finish.ts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Geographic Analysis (functions/api/geographic-analysis.ts)
# Optional -- if unset, Geographic Analysis still runs its local,
# in-browser measurements; only the Gemini natural-language interpretation
# layer is disabled ("not-configured", reported honestly in the UI).
GEMINI_API_KEY=

# Geographic Analysis' reverse-geocoding step calls OpenStreetMap's public
# Nominatim service (https://nominatim.openstreetmap.org). This needs no
# API key, only a descriptive User-Agent, which functions/_lib/nominatimServer.ts
# already supplies. Respect Nominatim's usage policy (max 1 request/second)
# if you change that implementation.
